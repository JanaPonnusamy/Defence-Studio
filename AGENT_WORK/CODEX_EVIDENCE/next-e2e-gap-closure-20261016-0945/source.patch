+             base + ["UPLOADED_PRIVATE", "PUBLISHING"],
+             base + ["UPLOADED_PRIVATE", "PUBLISHING", "SCHEDULED"],
+             base + ["UPLOADED_PRIVATE", "PUBLISHING", "PUBLISHED"]]
+    for i, path in enumerate(paths):
+        job = _job(pub, f"revoked-{i}")
