+def _is_eligible_claim(claim: dict, eligible_ids: set[str],
+                      sources_by_id: dict[str, dict]) -> bool:
+    """A claim qualifies as corroborating evidence only if it is in the
+    package's own authoritative ``eligible_claim_ids`` snapshot (the same set
+    ``EvidenceService._assemble`` computes from the current claim+source
+    review decisions) *and*, wherever this package also embeds the claim's
+    and its source's own review/staleness state, that state is consistent
+    with eligibility. A claim or source review/staleness state that is
+    missing, unrecognised, or contradicts the snapshot fails closed (treated
+    as ineligible) rather than silently assumed approved."""
+    claim_id = claim.get("claim_id")
+    if claim_id not in eligible_ids:
+        return False
+    claim_review = claim.get("review")
+    if claim_review is not None:
+        if claim_review.get("decision") != "APPROVED_FOR_USE":
+            return False
+        if claim.get("is_stale"):
+            return False
+    source = sources_by_id.get(claim.get("source_id"))
+    if source is not None:
+        source_review = source.get("review")
+        if source_review is not None:
+            if source_review.get("decision") != "APPROVED_FOR_USE":
+                return False
+            if source.get("is_stale"):
+                return False
+    return True
+
+
