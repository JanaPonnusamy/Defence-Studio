# Copy to .env and adjust as needed. All values are optional; sane defaults
# are defined in app/config.py. No secrets are required for the default
# mock-tts / local-pyttsx3 providers used in this standalone build.

# AUDIO_MODULE_STORAGE_ROOT=D:/Jana Soft/defenceStudio/standalone/audio-module/storage
# AUDIO_MODULE_DATABASE_URL=sqlite:///D:/Jana Soft/defenceStudio/standalone/audio-module/storage/audio_module.db
# AUDIO_MODULE_JOB_WORKER_THREADS=2
# AUDIO_MODULE_DEFAULT_TTS_PROVIDER=mock-tts
# AUDIO_MODULE_LOG_LEVEL=INFO

# If a real cloud TTS adapter is added later, its API key would be read
# ONLY from an environment variable such as AUDIO_MODULE_CLOUD_TTS_API_KEY
# and never logged or returned by any API response.
