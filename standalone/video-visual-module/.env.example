# Copy to .env (module root) and edit as needed. All values are optional; defaults live in app/config.py.
# Precedence: process environment > .env > defaults.
VIDEO_MODULE_STORAGE_ROOT=./storage
# VIDEO_MODULE_DATABASE_URL=sqlite:///./storage/video_visual_module.db   # default: <storage_root>/video_visual_module.db
VIDEO_MODULE_HOST=127.0.0.1
VIDEO_MODULE_PORT=8765
VIDEO_MODULE_LOG_LEVEL=INFO
VIDEO_MODULE_JOB_WORKER_THREADS=2
# placeholder-procedural = local PLACEHOLDER renderer (NOT AI; "local-procedural" is an accepted alias)
VIDEO_MODULE_DEFAULT_IMAGE_PROVIDER=placeholder-procedural
VIDEO_MODULE_ENABLED_IMAGE_PROVIDERS=["placeholder-procedural","mock-local","openai-images"]
VIDEO_MODULE_GENERATION_MAX_RETRIES=2
VIDEO_MODULE_DEFAULT_AI_IMAGE_BUDGET_USD=5.0
VIDEO_MODULE_DEFAULT_MAX_AI_IMAGES_PER_PLAN=4
VIDEO_MODULE_MAX_UPLOAD_BYTES=52428800
VIDEO_MODULE_MAX_SHOT_SECONDS=6.5
VIDEO_MODULE_MIN_SHOT_SECONDS=1.8
VIDEO_MODULE_WORDS_PER_MINUTE=150
# Optional shared secret. When set, every endpoint except /health, /docs, /openapi.json and /ui requires
# header X-API-Key. Never logged, never returned by any endpoint.
VIDEO_MODULE_API_KEY=

# ---- Optional real AI provider (OpenAI Images API). See docs/PROVIDER_SETUP.md. BILLABLE when used.
# Without a key the provider reports NOT_CONFIGURED and no request is ever made.
# OPENAI_API_KEY=
# VIDEO_MODULE_OPENAI_IMAGE_MODEL=gpt-image-2
# VIDEO_MODULE_OPENAI_BASE_URL=https://api.openai.com/v1
# VIDEO_MODULE_OPENAI_TIMEOUT_S=180
# Accept a clearly labelled PLACEHOLDER when a real AI request fails (default false: fail with a clear code)
VIDEO_MODULE_ALLOW_PLACEHOLDER_FALLBACK=false

# ---- Previews (optional local decoders: imageio-ffmpeg, pypdfium2)
VIDEO_MODULE_VIDEO_PREVIEWS_ENABLED=true
VIDEO_MODULE_PDF_PREVIEWS_ENABLED=true

# ---- Optional attributed basemap tiles for maps. OFF by default; schematic map is the fallback.
# Only use a tile service whose licence/usage policy you comply with. All three must be set.
# VIDEO_MODULE_BASEMAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# VIDEO_MODULE_BASEMAP_ATTRIBUTION=(c) Example tile provider
VIDEO_MODULE_BASEMAP_NETWORK_ENABLED=false
