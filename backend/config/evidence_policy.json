  "claim_classes": [
    {
      "id": "CASUALTY_LOSS",
      "patterns": [
        "\\bcasualt",
        "\\bkilled\\b",
        "\\bwounded\\b",
        "\\bfatalit",
        "\\blosses\\b",
        "\\bshot down\\b"
      ],
      "min_independent_groups": 2,
      "attribution_ok": true
    },
    {
      "id": "OPERATIONAL",
      "patterns": [
        "\\bdeployed\\b",
        "\\bdeployment\\b",
        "\\bused in combat\\b",
        "\\bintercept(?:ed|s|ion)?\\b",
        "\\bstruck\\b",
        "\\blaunched\\b",
        "\\bengaged\\b",
        "\\bin service\\b",
        "\\boperational(?:ly)?\\b"
      ],
      "min_independent_groups": 2,
      "attribution_ok": true
    },
    {
      "id": "CURRENT_EVENT",
      "patterns": [
        "\\bcurrently\\b",
        "\\brecently\\b",
        "\\bat present\\b",
        "\\bas of\\b",
        "\\bthis (?:week|month|year)\\b"
      ],
      "min_independent_groups": 2,
      "attribution_ok": true
    },
    {
      "id": "PERFORMANCE_FIGURE",
      "needs_quantity": true,
      "patterns": [
        "\\brange\\b",
        "\\bkm\\b",
        "\\bmach\\b",
        "\\bspeed\\b",
        "\\baltitude\\b",
        "\\bpayload\\b",
        "\\bkill probability\\b"
      ],
      "min_independent_groups": 2,
      "attribution_ok": false
    },
    {
      "id": "DESCRIPTIVE",
      "min_independent_groups": 1
    }
  ]
}
