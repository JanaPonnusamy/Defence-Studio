# Defence Studio — local environment template
# =====================================================================
# Copy this file to backend/.env.local (which is git-ignored) and fill in
# the values for THIS machine. NEVER commit a filled-in .env file: it holds
# your signing secret and any API keys.
#
#   Windows PowerShell:  Copy-Item .env.template backend\.env.local
#   Git Bash:            cp .env.template backend/.env.local
#
# The application reads these as process environment variables. The provided
# launch scripts (scripts/run_dev.ps1 / scripts/run_dev.sh) load this file for
# you before starting uvicorn.
# =====================================================================

# --- REQUIRED: authentication signing secret ---------------------------------
# A random secret of AT LEAST 32 bytes. Each machine should use its own; tokens
# minted on one machine are only valid where the same secret is configured.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DEFENCE_STUDIO_AUTH_SECRET=

# --- Database & artifact storage (project-relative defaults) -----------------
# Leave these UNSET to use the portable in-repo defaults:
#   DB      -> data/defence_studio.sqlite3   (the checked-in development DB)
#   storage -> data/storage                  (checked-in artifact bytes)
# Only set them to move the DB/artifacts off the repo (e.g. a scratch volume).
# Paths may be relative to the project root or absolute.
# DEFENCE_STUDIO_DB_PATH=data/defence_studio.sqlite3
# DEFENCE_STUDIO_STORAGE_PATH=data/storage

# The development launchers start a research consumer alongside the API.
# Set 0 to run API-only with scripts/run_research_worker.ps1 separately.
# Direct uvicorn startup is API-only unless this is explicitly set to 1.
# DEFENCE_STUDIO_RESEARCH_WORKER=1

# --- DEVELOPMENT AUTH BYPASS (local only; OFF by default) --------------------
# Both flags must be "1" to enable. When enabled, a DIRECT loopback request
# (127.0.0.1/::1, no proxy headers) is accepted as DEFENCE_STUDIO_DEV_AUTH_OWNER
# WITHOUT a bearer token, and GET /api/dev/session mints a short-lived token for
# the UI. This fails closed for any non-loopback origin and must NEVER be set in
# production. Leave unset/0 for production-equivalent behaviour.
# DEFENCE_STUDIO_DEV_MODE=1
# DEFENCE_STUDIO_DEV_AUTH_BYPASS=1
# The single owner a bypassed session acts as. Defaults to the included
# development job's owner so you can review it immediately after cloning.
DEFENCE_STUDIO_DEV_AUTH_OWNER=e2e-operator

# --- OPTIONAL: Phase 3 script generation (OpenAI text provider) --------------
# Only needed to actually generate scripts; tests never spend credits. Keep any
# real key in backend/.env.local only — never commit it.
# DEFENCE_STUDIO_OPENAI_API_KEY=
# DEFENCE_STUDIO_OPENAI_BASE_URL=https://api.openai.com/v1
# DEFENCE_STUDIO_OPENAI_USD_TO_INR=83.0

# --- OPTIONAL: Phase 1A discovery providers ----------------------------------
# RSS feeds (comma-separated URLs) and/or a configured search API. Unset means
# the provider reports "not configured" rather than silently returning nothing.
# DEFENCE_STUDIO_DISCOVERY_RSS_FEEDS=
# DEFENCE_STUDIO_DISCOVERY_SEARCH_API_URL=
# DEFENCE_STUDIO_DISCOVERY_SEARCH_API_KEY=
